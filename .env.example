# KasiDeposit API configuration. Copy to .env (which is gitignored) and fill in.
# Real environment variables override values in this file.

# --- Required -----------------------------------------------------------------

# development | test | production. No default: the app refuses to start without it.
ENVIRONMENT=development

# Postgres connection string. No default: the app refuses to start without it.
# Any postgres:// or postgresql:// URL works; it is switched to the psycopg 3 driver.
# Percent-encode special characters in the password ('@' becomes '%40').
#
# Local Postgres:
DATABASE_URL=postgresql://kasideposit:change-me@localhost:5432/kasideposit
#
# Hosted (Supabase): use Connect -> "Session pooler" (port 5432). The direct
# db.<ref>.supabase.co host is IPv6-only, and the transaction pooler (6543)
# does not suit psycopg.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# --- Optional -----------------------------------------------------------------

# One database, two schemas. The app uses DEV_SCHEMA in development and
# production; the test suite uses TEST_SCHEMA. They must differ: the suite
# truncates tables and would destroy the seeded demo vouchers, so it refuses
# to run if they are the same.
# DEV_SCHEMA=public
# TEST_SCHEMA=kd_test

# Demo vending routes under /demo. Default: true when ENVIRONMENT=development,
# false otherwise. The app refuses to start with this true in production.
# ENABLE_DEMO_ROUTES=true

# Voucher amount limits, in cents. Defaults: 1000 (R10) and 500000 (R5 000).
# MIN_VOUCHER_CENTS=1000
# MAX_VOUCHER_CENTS=500000

# Our fee per deposit, in cents, deducted from the voucher. Default: 500 (R5).
# FEE_CENTS=500

# How long a voucher lookup's token can be used to create a deposit. Default: 600.
# VOUCHER_TOKEN_TTL_SECONDS=600
