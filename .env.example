# KasiDeposit API configuration. Copy to .env (which is gitignored) and fill in.
# Real environment variables override values in this file.

# --- Required -----------------------------------------------------------------

# development | test | production. No default: the app refuses to start without it.
ENVIRONMENT=development

# Postgres connection string. No default: the app refuses to start without it.
# Any postgres:// or postgresql:// URL works; it is switched to the psycopg 3 driver.
# Percent-encode special characters in the password ('@' becomes '%40').
#
# Local Postgres:
DATABASE_URL=postgresql://kasideposit:change-me@localhost:5432/kasideposit
#
# Hosted (Supabase): use Connect -> "Session pooler" (port 5432). The direct
# db.<ref>.supabase.co host is IPv6-only, and the transaction pooler (6543)
# does not suit psycopg.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Optional -----------------------------------------------------------------

# Schema the app's tables live in. Default: public.
# DATABASE_SCHEMA=public

# Demo vending routes under /demo. Default: true when ENVIRONMENT=development,
# false otherwise. The app refuses to start with this true in production.
# ENABLE_DEMO_ROUTES=true

# Voucher amount limits, in cents. Defaults: 1000 (R10) and 500000 (R5 000).
# MIN_VOUCHER_CENTS=1000
# MAX_VOUCHER_CENTS=500000

# --- Tests only (read by tests/conftest.py, never by the app) --------------------

# The test suite TRUNCATES tables. It runs in its own schema, so it can safely
# share the development database: it never touches the app's schema there.
#
# Database for tests. Default: DATABASE_URL. If you point it at a separate
# database, it must not be the development one — or, if it is the same
# database, TEST_DATABASE_SCHEMA must differ from DATABASE_SCHEMA. The suite
# aborts rather than truncate development data.
# Local:  TEST_DATABASE_URL=postgresql://kasideposit:change-me@localhost:5432/kasideposit_test
# Hosted: TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Schema for tests; created if missing. Default: kasideposit_test.
# TEST_DATABASE_SCHEMA=kasideposit_test
